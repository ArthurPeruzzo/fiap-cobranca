# Copie para .env e ajuste. JWT_SECRET deve ser o mesmo da API principal (fiap-mecanica).
JWT_SECRET=
# RabbitMQ: o broker sobe no docker-compose do fiap-mecanica; usuario/senha iguais a RABBITMQ_COBRANCA_* de la.
RABBITMQ_VHOST=fiap
RABBITMQ_USERNAME=cobranca
RABBITMQ_PASSWORD=troque-por-uma-senha
# Opcional: so para enviar traces/metricas a New Relic.
NEW_RELIC_LICENSE_KEY=
